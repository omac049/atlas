<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlas.monitor</string>
    <!-- Invoked as `python -m atlas.cli`, never via `.venv/bin/atlas`: that
         console script is a text file, and launchd may execute a real binary
         from ~/Library/Group Containers but may NOT read a script there (the
         console-script form fails with "Operation not permitted", exit 78). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ocorral/Atlas/.venv/bin/python</string>
        <string>-m</string>
        <string>atlas.cli</string>
        <string>pairs</string>
        <string>watch</string>
        <string>--live</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Without this, stdout to a file is block-buffered: the monitor runs
             correctly but its log lags reality by many minutes, so a frontier
             "PUBLISHED RULES CHANGED" line can sit unflushed while the log looks
             idle. Observed 2026-08-17: ~19 minutes of completed cycles with zero
             bytes written. -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/ocorral/Atlas</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- One monitor only, per the one-monitor rule. -->
    <key>KeepAlive</key>
    <true/>
    <!-- Log lives in ~/Library/Logs, not the repo's data/ dir: launchd opens
         StandardOutPath itself before exec, and it may not create files under
         ~/Library/Group Containers (config error, exit 78). -->
    <key>StandardOutPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-monitor.log</string>
</dict>
</plist>
