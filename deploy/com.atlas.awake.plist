<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlas.awake</string>
    <!-- python -m form, never the console script: see deploy/README.md.
         Holds a caffeinate assertion through each scheduled release's burst
         window so the 05:30 jobs/CPI prints are not slept through. Cannot
         wake a sleeping Mac or survive a closed lid - see atlas_awake.py. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ocorral/Atlas/.venv/bin/python</string>
        <string>/Users/ocorral/Atlas/deploy/atlas_awake.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ocorral/Atlas</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-awake.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-awake.log</string>
</dict>
</plist>
