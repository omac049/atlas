<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlas.gsc</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ocorral/Atlas/.venv/bin/python</string>
        <string>/Users/ocorral/Atlas/deploy/atlas_gsc.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ocorral/Atlas</string>
    <!-- The key lives outside the repo (docs/GSC.md). Until it exists the job logs a skip. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>ATLAS_GSC_KEY_FILE</key>
        <string>/Users/ocorral/.config/atlas/gsc-service-account.json</string>
        <key>ATLAS_GSC_SITES</key>
        <string>sc-domain:samebetornot.com,sc-domain:verifiedfees.com</string>
    </dict>
    <!-- Daily at 06:15, after the two site rebuilds (04:00, 04:20). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-gsc-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ocorral/Library/Logs/atlas-gsc-stdout.log</string>
</dict>
</plist>
